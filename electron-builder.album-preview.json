{
  "appId": "com.local.roadtrip-retrospective-tool.photo-album-preview",
  "productName": "旅行轨迹记录与规划工具-相册实验版",
  "directories": {
    "output": "release-photo-album-preview",
    "buildResources": "build"
  },
  "files": [
    "backend/src/**/*",
    "dist/**/*",
    "electron/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "asar": true,
  "extraMetadata": {
    "name": "roadtrip-retrospective-photo-album-preview",
    "productName": "旅行轨迹记录与规划工具-相册实验版"
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "portable": {
    "artifactName": "${productName} ${version}.${ext}"
  }
}
