{
  "name": "roadtrip-retrospective-tool",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build": "tsc -b && vite build",
    "build:icon": "node scripts/create-car-icon.mjs",
    "package:win": "npm run build && npm run build:icon && electron-builder --win portable --x64",
    "package:win:album-preview": "npm run build && npm run build:icon && electron-builder --config electron-builder.album-preview.json --win portable --x64",
    "package:win:p0-fixes-test": "npm run build && npm run build:icon && electron-builder --config electron-builder.p0-fixes-test.json --win portable --x64",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "dev:frontend": "vite",
    "dev:backend": "node backend/src/index.js",
    "start:backend": "node backend/src/index.js",
    "desktop": "npm run build && electron ."
  },
  "dependencies": {
    "archiver": "7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exifr": "7.1.3",
    "express": "4.22.2",
    "extract-zip": "2.0.1",
    "leaflet": "^1.9.4",
    "marked": "^18.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "6.2.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.local.roadtrip-retrospective-tool",
    "productName": "旅行轨迹记录与规划工具",
    "extraMetadata": {
      "name": "roadtrip-retrospective-photo-album",
      "productName": "旅行轨迹记录与规划工具"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "backend/src/**/*",
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName} ${version}.${ext}"
    }
  },
  "description": "Desktop app for roadtrip route recording and planning.",
  "author": "Local User"
}
